@model EmployeeDirectory.Models.EmployeeDetailsViewModel
@{
    ViewData["Title"] = "Employee Details";
    var employee = Model.Employee;
}

<h1 class="page-title" data-testid="page-title">Employee Details</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert" data-testid="status-message">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card p-4" style="max-width: 700px;" data-testid="employee-details-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Full Name</dt>
        <dd class="col-sm-8" data-testid="detail-fullname">@employee.FullName</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8" data-testid="detail-email">@employee.Email</dd>

        <dt class="col-sm-4">Title</dt>
        <dd class="col-sm-8" data-testid="detail-title">@employee.Title</dd>

        <dt class="col-sm-4">Department</dt>
        <dd class="col-sm-8" data-testid="detail-department">@employee.Department</dd>

        <dt class="col-sm-4">Hire Date</dt>
        <dd class="col-sm-8" data-testid="detail-hiredate">@employee.HireDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">
            <span class="badge status-badge status-@employee.Status" data-testid="current-status">@employee.Status</span>
        </dd>
    </dl>
</div>

<div class="mt-3 d-flex gap-2">
    @if (employee.Status != EmployeeDirectory.Models.EmployeeStatus.Terminated)
    {
        <a asp-action="ChangeStatus" asp-route-id="@employee.Id" class="btn btn-success"
           data-testid="change-status-button">Change Status</a>
    }
    <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-primary" data-testid="edit-button">Edit</a>
    <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-outline-danger" data-testid="delete-button">Delete</a>
    <a asp-action="Index" class="btn btn-outline-secondary" data-testid="back-button">Back to Search</a>
</div>

<section class="card p-4 mt-4" data-testid="status-history-panel">
    <h2 class="h4">Employment Status History</h2>
    @if (Model.StatusHistory.Count == 0)
    {
        <p class="text-muted mb-0" data-testid="status-history-empty">No status changes have been recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0" data-testid="status-history-table">
                <thead>
                    <tr>
                        <th>Previous Status</th>
                        <th>New Status</th>
                        <th>Effective Date</th>
                        <th>Reason</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.StatusHistory)
                    {
                        <tr data-testid="status-history-row-@item.Id">
                            <td data-testid="history-previous-status">@item.PreviousStatus</td>
                            <td data-testid="history-new-status">@item.NewStatus</td>
                            <td data-testid="history-effective-date">@item.EffectiveDate.ToString("yyyy-MM-dd")</td>
                            <td data-testid="history-reason">@item.Reason</td>
                            <td data-testid="history-notes">@(item.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
