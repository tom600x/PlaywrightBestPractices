@model EmployeeDirectory.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<h1 class="page-title text-danger" data-testid="page-title">Delete Employee</h1>

<div class="alert alert-danger" data-testid="delete-warning">
    Are you sure you want to delete this employee? This action cannot be undone.
</div>

<div class="card p-4" style="max-width: 700px;" data-testid="employee-details-card">
    <dl class="row mb-0">
        <dt class="col-sm-4">Full Name</dt>
        <dd class="col-sm-8" data-testid="detail-fullname">@Model.FullName</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8" data-testid="detail-email">@Model.Email</dd>

        <dt class="col-sm-4">Department</dt>
        <dd class="col-sm-8" data-testid="detail-department">@Model.Department</dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">
            <span class="badge status-badge status-@Model.Status" data-testid="detail-status">@Model.Status</span>
        </dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3 d-flex gap-2" data-testid="delete-form">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" data-testid="confirm-delete-button">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary" data-testid="cancel-button">Cancel</a>
</form>
