@model EmployeeDirectory.Models.ChangeEmployeeStatusViewModel
@{
    ViewData["Title"] = "Change Employment Status";
}

<h1 class="page-title" data-testid="page-title">Change Employment Status</h1>

<div class="card p-4" style="max-width: 700px;">
    <div class="mb-3">
        <div class="text-muted">Employee</div>
        <strong data-testid="status-employee-name">@Model.EmployeeName</strong>
    </div>

    <div class="mb-3">
        <div class="text-muted">Current Status</div>
        <span class="badge status-badge status-@Model.CurrentStatus"
              data-testid="current-status">@Model.CurrentStatus</span>
    </div>

    <form asp-action="ChangeStatus" method="post" data-testid="status-change-form">
        <input type="hidden" asp-for="EmployeeId" />
        <input type="hidden" asp-for="EmployeeName" />
        <input type="hidden" asp-for="CurrentStatus" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"
             data-testid="status-validation-summary"></div>

        <div class="mb-3">
            <label asp-for="NewStatus" class="form-label"></label>
            <select asp-for="NewStatus" class="form-select" data-testid="new-status"
                    asp-items="Html.GetEnumSelectList<EmployeeDirectory.Models.EmployeeStatus>()"></select>
            <span asp-validation-for="NewStatus" class="text-danger"
                  data-testid="error-new-status"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EffectiveDate" class="form-label"></label>
            <input asp-for="EffectiveDate" type="date" class="form-control"
                   data-testid="effective-date" />
            <span asp-validation-for="EffectiveDate" class="text-danger"
                  data-testid="error-effective-date"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" data-testid="status-reason" />
            <span asp-validation-for="Reason" class="text-danger"
                  data-testid="error-status-reason"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"
                      data-testid="status-notes"></textarea>
            <span asp-validation-for="Notes" class="text-danger"
                  data-testid="error-status-notes"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"
                    data-testid="save-status-button">Save Status Change</button>
            <a asp-action="Details" asp-route-id="@Model.EmployeeId"
               class="btn btn-outline-secondary" data-testid="cancel-status-button">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
